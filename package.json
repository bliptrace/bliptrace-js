{
  "name": "@bliptrace/js",
  "version": "1.0.0",
  "description": "Runtime JavaScript/TypeScript SDK for Bliptrace — build, scrub and ship error envelopes to the ingest API. Works in Node and the browser; framework SDKs (bliptrace-express, bliptrace-nextjs) extend this.",
  "keywords": [
    "bliptrace",
    "error-tracking",
    "observability",
    "sdk",
    "javascript",
    "typescript"
  ],
  "license": "MIT",
  "author": "Developers Hub Sdn Bhd",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bliptrace/bliptrace-js.git"
  },
  "homepage": "https://scope.g8suite.com",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
